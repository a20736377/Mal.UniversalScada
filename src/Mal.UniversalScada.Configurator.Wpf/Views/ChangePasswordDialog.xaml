<Window x:Class="Mal.UniversalScada.Configurator.Wpf.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改管理员登录密码"
        Height="390" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        Foreground="#0F172A">

    <Window.Resources>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.05" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="🔑 修改管理员密码" FontSize="18" FontWeight="Bold" Foreground="#0284C7"/>
                    <TextBlock Text="请输入原密码并设置新的登录密码" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="原密码:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtOldPassword" Height="34" Margin="0,0,0,10"/>

                    <TextBlock Text="新密码 (不少于6位):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtNewPassword" Height="34" Margin="0,0,0,10"/>

                    <TextBlock Text="确认新密码:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtConfirmPassword" Height="34" Margin="0,0,0,10"/>

                    <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" MinHeight="16"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="取消" Width="80" Height="34" Margin="0,0,10,0" 
                            Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold"
                            IsCancel="True" Click="BtnCancel_Click"/>
                    <Button Content="确认修改" Width="90" Height="34" 
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                            IsDefault="True" Click="BtnSubmit_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
