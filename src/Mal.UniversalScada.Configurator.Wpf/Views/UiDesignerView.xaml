<UserControl x:Class="Mal.UniversalScada.Configurator.Wpf.Views.UiDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mal.UniversalScada.Configurator.Wpf.ViewModels"
             xmlns:widgets="clr-namespace:Mal.UniversalScada.UI.Controls.Widgets;assembly=Mal.UniversalScada.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:UiDesignerViewModel}">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/> <!-- 画面方案管理导航条 -->
            <RowDefinition Height="*"/>  <!-- 三栏设计器主体 -->
            <RowDefinition Height="28"/> <!-- 设计器底部状态 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部画面方案选择与保存栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🖥️ 当前可视化画面方案:" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Views}" SelectedItem="{Binding SelectedView}" DisplayMemberPath="Name"
                              Width="220" Height="32" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                    <Button Content="➕ 新建画面" Padding="10,4" Height="30" Margin="0,0,6,0"
                            Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                            Command="{Binding CreateNewViewCommand}"/>

                    <Button Content="🗑️ 删除画面" Padding="10,4" Height="30" Margin="0,0,6,0"
                            Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                            Command="{Binding DeleteCurrentViewCommand}"/>

                    <Button Content="★ 设为默认展示" Padding="10,4" Height="30" Margin="0,0,6,0"
                            Background="#F0FDF4" Foreground="#16A34A" BorderBrush="#BBF7D0" BorderThickness="1"
                            Command="{Binding SetCurrentViewAsDefaultCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="💾 保存当前画面方案 (WYSIWYG)" Padding="16,6" Height="34"
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                            Command="{Binding SaveCurrentViewCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 三栏设计器主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" MaxWidth="320"/> <!-- 左侧工具箱 -->
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>                                  <!-- 中间科技网格画布 -->
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="300" MinWidth="260" MaxWidth="400"/> <!-- 右侧属性检查器 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧：工业组件工具箱 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🛠️ 工业组件工具箱" FontWeight="Bold" FontSize="13" Foreground="#0369A1" Margin="0,0,0,6"/>
                    <TextBlock DockPanel.Dock="Top" Text="可拖拽或双击插入画布" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>

                    <ListBox x:Name="ToolboxListBox" ItemsSource="{Binding ToolboxItems}" Background="Transparent" BorderThickness="0"
                             PreviewMouseLeftButtonDown="OnToolboxPreviewMouseLeftButtonDown"
                             MouseMove="OnToolboxMouseMove"
                             MouseDoubleClick="OnToolboxItemDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                        Padding="8,6" Margin="0,0,0,6" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E2E8F0"/>

            <!-- 中间：暗色科技网格画布 (所见即所得编辑区) -->
            <Border Grid.Column="2" Background="#070B14">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="DesignerCanvasGrid" Width="1600" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top"
                          Margin="20" MouseDown="OnCanvasMouseDown"
                          AllowDrop="True" DragOver="OnCanvasDragOver" Drop="OnCanvasDrop">
                        <!-- 暗黑网格装饰线 (100px 与 20px) -->
                        <Grid.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,40,40"/>
                                        </GeometryDrawing.Geometry>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#131F37" Thickness="1"/>
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Grid.Background>

                        <!-- 画布顶部水印标尺 -->
                        <TextBlock Text="[ WYSIWYG DESIGNER CANVAS - 1600 x 900 | 支持组件自由拖拽与属性即时联动 ]" Foreground="#1E293B" FontSize="11"
                                   FontFamily="Consolas" Margin="14,10,0,0" IsHitTestVisible="False"/>

                        <!-- 组件集合容器 (以 Canvas 绝对定位呈现) -->
                        <ItemsControl ItemsSource="{Binding Widgets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas IsItemsHost="True" Width="1600" Height="900" Background="Transparent"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
                                    <Setter Property="Panel.ZIndex" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="999"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <widgets:WidgetHost />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#E2E8F0"/>

            <!-- 右侧：属性检查器 (所见即所得双向绑定修改) -->
            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 组件被选中时展示组件属性 -->
                        <StackPanel Visibility="{Binding SelectedWidget, Converter={x:Static vm:DesignerUiConverters.NullToCollapsed}}">
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="⚙️ 组件属性检查器" FontSize="14" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                <Button Content="🗑️ 删除组件" Foreground="#DC2626" Background="#FEE2E2" BorderThickness="0"
                                        Padding="8,3" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"
                                        Command="{Binding DeleteWidgetCommand}" CommandParameter="{Binding SelectedWidget}"/>
                            </DockPanel>

                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="组件唯一编号 ID:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedWidget.Id}" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                    <TextBlock Text="组件类型:" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedWidget.Type}" FontWeight="SemiBold" FontSize="12" Foreground="#0369A1"/>
                                </StackPanel>
                            </Border>

                            <!-- 标题 -->
                            <TextBlock Text="展示标题 / 标签 (Title):" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedWidget.Title, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

                            <!-- 绑定主点位 -->
                            <TextBlock Text="绑定采集点位 (PrimaryTagId):" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableTagIds}" SelectedItem="{Binding SelectedWidget.PrimaryTagId}"
                                      Height="30" Margin="0,0,0,10"/>

                            <!-- 坐标与大小 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X 坐标 (px):" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedWidget.X, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y 坐标 (px):" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedWidget.Y, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="宽度 Width:" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedWidget.Width, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="高度 Height:" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedWidget.Height, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                </StackPanel>
                            </Grid>

                            <!-- 2.1 仪表盘专属配置 (GaugeCircular) -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='GaugeCircular'}">
                                <StackPanel>
                                    <TextBlock Text="⏱️ 圆形仪表盘专属组合参数 (CircularGaugeProps)" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="量程下限 (Min):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.GaugeProps.MinValue, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="量程上限 (Max):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.GaugeProps.MaxValue, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="工程单位 (Unit, 如 ℃ / bar / rpm):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedWidget.GaugeProps.Unit, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="高限告警阈值 (HighAlarm):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.GaugeProps.HighAlarm, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="低限告警阈值 (LowAlarm):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.GaugeProps.LowAlarm, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="小数位数 (Decimals):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.GaugeProps.Decimals, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="表盘主题色 (ColorHex):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.GaugeProps.ColorHex, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2.2 储罐专属配置 (LevelTank) -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='LevelTank'}">
                                <StackPanel>
                                    <TextBlock Text="🛢️ 立体储罐专属组合参数 (TankLevelProps)" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="容量下限 (Min):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.TankProps.MinValue, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="容量上限 (Max):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.TankProps.MaxValue, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="液位单位 (Unit, 如 % / L / m³):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedWidget.TankProps.Unit, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="溢出报警液位 (High):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.TankProps.HighAlarm, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="干涸预警液位 (Low):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.TankProps.LowAlarm, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="液体渲染色 (ColorHex):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedWidget.TankProps.ColorHex, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                </StackPanel>
                            </Border>

                            <!-- 2.3 科技数显卡片专属配置 (NumericCard, TextLabel, SetpointInput) -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='NumericCard,TextLabel,SetpointInput'}">
                                <StackPanel>
                                    <TextBlock Text="📟 数显科技卡片专属组合参数 (NumericCardProps)" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,8"/>

                                    <TextBlock Text="物理工程单位 (Unit, 如 mm/s / kW / ℃):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedWidget.CardProps.Unit, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="小数保留位数 (Decimals):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.CardProps.Decimals, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="数显发光色 (ColorHex):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.CardProps.ColorHex, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2.4 IO 状态点阵专属配置 (IoMatrix) -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='IoMatrix'}">
                                <StackPanel>
                                    <TextBlock Text="🎛️ IO 点阵矩阵专属组合参数 (IoMatrixProps)" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="输入通道路数 (Channels):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <ComboBox Text="{Binding SelectedWidget.IoProps.IoChannels, UpdateSourceTrigger=PropertyChanged}" Height="26" IsEditable="True">
                                                <ComboBoxItem Content="8"/>
                                                <ComboBoxItem Content="16"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="显示进制 (DisplayFormat):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <ComboBox Text="{Binding SelectedWidget.IoProps.DisplayFormat, UpdateSourceTrigger=PropertyChanged}" Height="26" IsEditable="True">
                                                <ComboBoxItem Content="HEX"/>
                                                <ComboBoxItem Content="BIN"/>
                                                <ComboBoxItem Content="DEC"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="导通点亮颜色 (ActiveColor):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedWidget.IoProps.ActiveColor, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                </StackPanel>
                            </Border>

                            <!-- 2.5 工业指示灯专属配置 (StatusLed) -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='StatusLed'}">
                                <StackPanel>
                                    <TextBlock Text="💡 工业状态指示灯专属组合参数 (StatusLedProps)" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="点亮激活颜色 (Active):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.LedProps.ActiveColor, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="熄灭底色 (Inactive):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.LedProps.InactiveColor, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="导通提示文案 (OnText):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.LedProps.OnText, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="熄灭提示文案 (OffText):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.LedProps.OffText, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Content="🚨 异常呼吸闪烁提醒 (EnableBlink)" IsChecked="{Binding SelectedWidget.LedProps.EnableBlink}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 2.6 控制按钮专属配置 (ControlButton) -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='ControlButton'}">
                                <StackPanel>
                                    <TextBlock Text="🔘 工业控制按钮专属组合参数 (ControlButtonProps)" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,8"/>

                                    <TextBlock Text="按钮显示文字 (ButtonText):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedWidget.ButtonProps.ButtonText, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="动作模式 (Mode):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <ComboBox Text="{Binding SelectedWidget.ButtonProps.ButtonMode, UpdateSourceTrigger=PropertyChanged}" Height="26" IsEditable="True">
                                                <ComboBoxItem Content="DirectWrite"/>
                                                <ComboBoxItem Content="Toggle"/>
                                                <ComboBoxItem Content="Momentary"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="写入数值 (Value):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedWidget.ButtonProps.WriteValue, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="按钮底色 (ColorHex):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedWidget.ButtonProps.ColorHex, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>

                                    <CheckBox Content="🛡️ 下发前弹出二次确认窗口 (防误触)" IsChecked="{Binding SelectedWidget.ButtonProps.RequireConfirm}" Margin="0,2,0,4"/>
                                    <TextBox Text="{Binding SelectedWidget.ButtonProps.ConfirmMessage, UpdateSourceTrigger=PropertyChanged}" Height="26"
                                             IsEnabled="{Binding SelectedWidget.ButtonProps.RequireConfirm}"/>
                                </StackPanel>
                            </Border>

                            <!-- 3. 即时动态预览调试 (所见即所得测试) -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="🔍 画面动态即时预览调试" FontWeight="SemiBold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,6"/>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="当前呈现值:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedWidget.FormattedValue}" FontWeight="Bold" FontSize="12" Foreground="#0284C7" HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <!-- 模拟量滑块调试 (仪表、储罐、数显) -->
                                    <Slider Minimum="{Binding SelectedWidget.MinValue}" Maximum="{Binding SelectedWidget.MaxValue}"
                                            Value="{Binding SelectedWidget.CurrentRawValue, Mode=TwoWay}"
                                            Margin="0,4,0,6" ValueChanged="OnPreviewSliderValueChanged"/>

                                    <!-- 快速模拟按钮 (针对开关量、状态灯、控制按钮) -->
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⚡ 快速置 1 (导通/运行)" Height="24" FontSize="10" Background="#DCFCE7" Foreground="#15803D" BorderBrush="#86EFAC" Click="OnSimulateValueOneClick"/>
                                        <Button Grid.Column="2" Content="⏹️ 快速置 0 (截止/停机)" Height="24" FontSize="10" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" Click="OnSimulateValueZeroClick"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 未选中组件时展示画面全局属性 -->
                        <StackPanel Visibility="{Binding SelectedWidget, Converter={x:Static vm:DesignerUiConverters.NullToVisible}}">
                            <TextBlock Text="📄 画面全局参数" FontSize="14" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,12"/>

                            <TextBlock Text="画面 ID:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedView.ViewId}" IsReadOnly="True" Background="#F1F5F9" Height="28" Margin="0,0,0,10"/>

                            <TextBlock Text="画面名称 (Name):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedView.Name}" Height="28" Margin="0,0,0,10"/>

                            <TextBlock Text="画布参考宽度 (px):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedView.CanvasWidth}" Height="28" Margin="0,0,0,10"/>

                            <TextBlock Text="画布参考高度 (px):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedView.CanvasHeight}" Height="28" Margin="0,0,0,10"/>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                <TextBlock Text="💡 提示: 从左侧工具箱拖拽或双击向画布添加组件；在画布上可自由拖动组件调整坐标；选中组件在右侧即时配置标题与点位！"
                                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. 底部状态栏 -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#475569"/>
                <TextBlock Text="WPF WYSIWYG SCADA Designer" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
