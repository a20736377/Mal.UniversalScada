<UserControl x:Class="Mal.UniversalScada.Configurator.Wpf.Views.UiDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mal.UniversalScada.Configurator.Wpf.ViewModels"
             xmlns:controls="clr-namespace:Mal.UniversalScada.UI.Controls.Controls;assembly=Mal.UniversalScada.UI.Controls"
             xmlns:propertyEditors="clr-namespace:Mal.UniversalScada.UI.Controls.PropertyEditors;assembly=Mal.UniversalScada.UI.Controls"
             xmlns:widgets="clr-namespace:Mal.UniversalScada.UI.Controls.Widgets;assembly=Mal.UniversalScada.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:UiDesignerViewModel}">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/> <!-- 画面方案管理导航条 -->
            <RowDefinition Height="*"/>  <!-- 三栏设计器主体 -->
            <RowDefinition Height="28"/> <!-- 设计器底部状态 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部画面方案选择与保存栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🖥️ 当前可视化画面方案:" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Views}" SelectedItem="{Binding SelectedView}"
                              Width="260" Height="32" VerticalContentAlignment="Center" Margin="0,0,10,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id, StringFormat='[#{0}] '}" FontWeight="Bold" Foreground="#0284C7"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="➕ 新建画面" Padding="10,4" Height="30" Margin="0,0,6,0"
                            Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                            Command="{Binding CreateNewViewCommand}"/>

                    <Button Content="🗑️ 删除画面" Padding="10,4" Height="30" Margin="0,0,6,0"
                            Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                            Command="{Binding DeleteCurrentViewCommand}"/>

                    <Button Content="★ 设为默认展示" Padding="10,4" Height="30" Margin="0,0,6,0"
                            Background="#F0FDF4" Foreground="#16A34A" BorderBrush="#BBF7D0" BorderThickness="1"
                            Command="{Binding SetCurrentViewAsDefaultCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="💾 保存当前画面方案 (WYSIWYG)" Padding="16,6" Height="34"
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                            Command="{Binding SaveCurrentViewCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 三栏设计器主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" MaxWidth="320"/> <!-- 左侧工具箱 -->
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>                                  <!-- 中间科技网格画布 -->
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="300" MinWidth="260" MaxWidth="400"/> <!-- 右侧属性检查器 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧：工业组件工具箱 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🛠️ 工业组件工具箱" FontWeight="Bold" FontSize="13" Foreground="#0369A1" Margin="0,0,0,6"/>
                    <TextBlock DockPanel.Dock="Top" Text="可拖拽或双击插入画布" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>

                    <ListBox x:Name="ToolboxListBox" ItemsSource="{Binding ToolboxItems}" Background="Transparent" BorderThickness="0"
                             PreviewMouseLeftButtonDown="OnToolboxPreviewMouseLeftButtonDown"
                             MouseMove="OnToolboxMouseMove"
                             MouseDoubleClick="OnToolboxItemDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                        Padding="8,6" Margin="0,0,0,6" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E2E8F0"/>

            <!-- 中间：暗色科技网格画布 (所见即所得编辑区) -->
            <Border Grid.Column="2" Background="#070B14">
                <DockPanel>
                    <!-- 画布顶部快捷排版工具条 (多选对齐、图层层级、剪贴板) -->
                    <Border DockPanel.Dock="Top" Background="#0D1424" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,6">
                        <Border.Resources>
                            <!-- 科技暗黑风格工具条按钮模板 (彻底杜绝 WPF 禁用态变白、文字看不清的系统缺陷) -->
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="7,3"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter x:Name="contentPresenter"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- 鼠标悬停高亮 -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#2563EB"/>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#3B82F6"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <!-- 鼠标按下微下沉 -->
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#1E40AF"/>
                                                    <Setter Property="Foreground" Value="#93C5FD"/>
                                                </Trigger>
                                                <!-- 禁用态：深沉微暗底色 + 清晰可读灰色文字，彻底杜绝白底反光！ -->
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#111A2E"/>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#1A2438"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- 危险操作专用模板 (如删除按钮) -->
                            <Style x:Key="ToolbarDangerButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="#2D1515"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                                <Setter Property="BorderBrush" Value="#451A1A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="7,3"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#DC2626"/>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#EF4444"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#991B1B"/>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#B91C1C"/>
                                                    <Setter Property="Foreground" Value="#FECACA"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#111A2E"/>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#1A2438"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>

                        <DockPanel>
                            <!-- 左侧：选中计数与状态指示 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="📐 画布排版工具" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedCount, StringFormat='已选中 {0} 项'}" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <!-- 工具按钮区 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 历史栈 (撤销/重做) -->
                                <Button Content="↩ 撤销" ToolTip="撤销上一步操作 (Ctrl+Z)"
                                        Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                                        Margin="2,0"/>
                                <Button Content="↪ 重做" ToolTip="恢复重做操作 (Ctrl+Y)"
                                        Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                                        Margin="2,0"/>

                                <Rectangle Width="1" Height="16" Fill="#334155" Margin="6,0"/>

                                <!-- 成组与解组 -->
                                <Button Content="🔗 编组" ToolTip="将选中组件组合成组 (Ctrl+G)"
                                        Command="{Binding GroupSelectedWidgetsCommand}" IsEnabled="{Binding CanGroup}"
                                        Margin="2,0"/>
                                <Button Content="🔓 解组" ToolTip="解除选中的组件编组 (Ctrl+Shift+G)"
                                        Command="{Binding UngroupSelectedWidgetsCommand}" IsEnabled="{Binding CanUngroup}"
                                        Margin="2,0"/>

                                <Rectangle Width="1" Height="16" Fill="#334155" Margin="6,0"/>

                                <!-- 对齐组 (左/右/顶/底/水平居中/垂直居中) -->
                                <Button Content="⇤ 左对齐" ToolTip="选中的组件以最左侧基准对齐"
                                        Command="{Binding AlignLeftCommand}" IsEnabled="{Binding HasMultipleSelection}"
                                        Margin="2,0"/>
                                <Button Content="⇥ 右对齐" ToolTip="选中的组件以最右侧基准对齐"
                                        Command="{Binding AlignRightCommand}" IsEnabled="{Binding HasMultipleSelection}"
                                        Margin="2,0"/>
                                <Button Content="⤒ 顶对齐" ToolTip="选中的组件以最上方基准对齐"
                                        Command="{Binding AlignTopCommand}" IsEnabled="{Binding HasMultipleSelection}"
                                        Margin="2,0"/>
                                <Button Content="⤓ 底对齐" ToolTip="选中的组件以最下方基准对齐"
                                        Command="{Binding AlignBottomCommand}" IsEnabled="{Binding HasMultipleSelection}"
                                        Margin="2,0"/>
                                <Button Content="⫾ 水平居中" ToolTip="选中的组件水平中心线对齐"
                                        Command="{Binding AlignCenterHorizontalCommand}" IsEnabled="{Binding HasMultipleSelection}"
                                        Margin="2,0"/>
                                <Button Content="⫿ 垂直居中" ToolTip="选中的组件垂直中心线对齐"
                                        Command="{Binding AlignCenterVerticalCommand}" IsEnabled="{Binding HasMultipleSelection}"
                                        Margin="2,0"/>
                                <Button Content="⇹ 横向均分" ToolTip="选中的 3 个及以上组件水平等间距均分分布"
                                        Command="{Binding DistributeHorizontallyCommand}" IsEnabled="{Binding HasMultipleSelection}"
                                        Margin="2,0"/>
                                <Button Content="⇳ 纵向均分" ToolTip="选中的 3 个及以上组件垂直等间距均分分布"
                                        Command="{Binding DistributeVerticallyCommand}" IsEnabled="{Binding HasMultipleSelection}"
                                        Margin="2,0"/>

                                <Rectangle Width="1" Height="16" Fill="#334155" Margin="6,0"/>

                                <!-- 图层层级控制 -->
                                <Button Content="⤊ 置顶" ToolTip="将所选组件移到图层最顶层"
                                        Command="{Binding BringToFrontCommand}" IsEnabled="{Binding HasSelection}"
                                        Margin="2,0"/>
                                <Button Content="⤋ 置底" ToolTip="将所选组件移到图层最底层"
                                        Command="{Binding SendToBackCommand}" IsEnabled="{Binding HasSelection}"
                                        Margin="2,0"/>
                                <Button Content="∧ 上移" ToolTip="将所选组件上移一层"
                                        Command="{Binding BringForwardCommand}" IsEnabled="{Binding HasSelection}"
                                        Margin="2,0"/>
                                <Button Content="∨ 下移" ToolTip="将所选组件下移一层"
                                        Command="{Binding SendBackwardCommand}" IsEnabled="{Binding HasSelection}"
                                        Margin="2,0"/>

                                <Rectangle Width="1" Height="16" Fill="#334155" Margin="6,0"/>

                                <!-- 剪贴板与快捷操作 -->
                                <Button Content="📄 复制" ToolTip="复制所选组件 (Ctrl+C)"
                                        Command="{Binding CopySelectionCommand}" IsEnabled="{Binding HasSelection}"
                                        Margin="2,0"/>
                                <Button Content="📋 粘贴" ToolTip="粘贴组件副本 (Ctrl+V)"
                                        Command="{Binding PasteSelectionCommand}"
                                        Margin="2,0"/>
                                <Button Content="🔲 全选" ToolTip="全选所有组件 (Ctrl+A)"
                                        Command="{Binding SelectAllWidgetsCommand}"
                                        Margin="2,0"/>
                                <Button Content="🗑️ 删除" ToolTip="删除所选组件 (Delete)"
                                        Style="{StaticResource ToolbarDangerButtonStyle}"
                                        Command="{Binding DeleteSelectedWidgetsCommand}" IsEnabled="{Binding HasSelection}"
                                        Margin="2,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="DesignerCanvasGrid" Width="1600" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Margin="20" MouseDown="OnCanvasMouseDown"
                              AllowDrop="True" DragOver="OnCanvasDragOver" Drop="OnCanvasDrop">
                            <!-- 暗黑网格装饰线 (100px 与 20px) -->
                            <Grid.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing>
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,40,40"/>
                                            </GeometryDrawing.Geometry>
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#131F37" Thickness="1"/>
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.Background>

                            <!-- 画布工艺流程/设备底图 (支持透明度与拉伸模式) -->
                            <Image Source="{Binding SelectedView.BackgroundImagePath}"
                                   Stretch="{Binding SelectedView.BackgroundImageStretch}"
                                   Opacity="{Binding SelectedView.BackgroundImageOpacity}"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                            <!-- 画布顶部水印标尺 -->
                            <TextBlock Text="[ WYSIWYG DESIGNER CANVAS - 1600 x 900 | 支持组件自由拖拽与属性即时联动 ]" Foreground="#334155" FontSize="11"
                                       FontFamily="Consolas" Margin="14,10,0,0" IsHitTestVisible="False"/>

                            <!-- 组件集合容器 (以 Canvas 绝对定位呈现) -->
                            <ItemsControl ItemsSource="{Binding Widgets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True" Width="1600" Height="900" Background="Transparent"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
                                        <Setter Property="Panel.ZIndex" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="PanelContainer">
                                                <Setter Property="Panel.ZIndex" Value="0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Panel.ZIndex" Value="999"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <widgets:WidgetHost />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#E2E8F0"/>

            <!-- 右侧：属性检查器 (所见即所得双向绑定修改) -->
            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 组件被选中时展示组件属性 -->
                        <StackPanel Visibility="{Binding SelectedWidget, Converter={x:Static vm:DesignerUiConverters.NullToCollapsed}}">
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="⚙️ 组件属性检查器" FontSize="14" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                <Button Content="🗑️ 删除组件" Foreground="#DC2626" Background="#FEE2E2" BorderThickness="0"
                                        Padding="8,3" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"
                                        Command="{Binding DeleteWidgetCommand}" CommandParameter="{Binding SelectedWidget}"/>
                            </DockPanel>

                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="组件唯一编号 ID:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedWidget.Id}" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                    <TextBlock Text="组件类型:" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedWidget.Type}" FontWeight="SemiBold" FontSize="12" Foreground="#0369A1"/>
                                </StackPanel>
                            </Border>

                            <!-- 0. ⚡ 快捷样式与行业模板预设 (Quick Styles & Presets) -->
                            <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                                    Visibility="{Binding SelectedWidget.AvailablePresets.Count, Converter={x:Static vm:DesignerUiConverters.CountToVisibility}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="⚡ 快捷样式与行业预设" FontWeight="Bold" FontSize="12" Foreground="#15803D" VerticalAlignment="Center"/>
                                        <TextBlock Text="一键秒级套用" FontSize="9" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- 样式下拉选择器 -->
                                    <ComboBox ItemsSource="{Binding SelectedWidget.AvailablePresets}"
                                              SelectedItem="{Binding SelectedWidget.SelectedPreset, Mode=TwoWay}"
                                              Height="30" Margin="0,0,0,6">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2,0">
                                                    <TextBlock Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                    <Border Background="#E2E8F0" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#64748B"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- 快捷说明文字提示 -->
                                    <TextBlock Text="{Binding SelectedWidget.SelectedPreset.Description, FallbackValue='请从上方下拉列表一键选择行业模板样式'}"
                                               FontSize="10" Foreground="#166534" TextWrapping="Wrap" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 标题 (对普通组件展示，对 TextLabel 纯静态文本组件直接在下方专属面板编辑，无需重复标题) -->
                            <StackPanel Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='!TextLabel'}">
                                <TextBlock Text="展示标题 / 标签 (Title):" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedWidget.Title, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>
                            </StackPanel>
                            <!-- 绑定主点位 (带数据类型精准过滤，静态标签、容器与图片组件无需绑定) -->
                            <StackPanel Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='!TextLabel,!PanelContainer,!Image'}">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="绑定采集点位 (Tag):" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBlock Text="🎯 仅显示兼容数据类型" FontSize="9" Foreground="#0284C7" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ComboBox ItemsSource="{Binding FilteredAvailableTags}"
                                          SelectedValue="{Binding SelectedWidget.PrimaryTagId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayText"
                                          Height="30" Margin="0,0,0,4"/>

                                <!-- 所选点位详细信息与数据类型徽章卡片 -->
                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,10"
                                        Visibility="{Binding SelectedTagInfo, Converter={x:Static vm:DesignerUiConverters.NullToCollapsed}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0284C7" CornerRadius="3" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedTagInfo.DataTypeLabel}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedTagInfo.Name}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SelectedTagInfo.DetailSummary}" FontSize="9" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 坐标与大小 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X 坐标 (px):" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedWidget.X, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y 坐标 (px):" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedWidget.Y, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="宽度 Width:" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedWidget.Width, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="高度 Height:" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedWidget.Height, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                </StackPanel>
                            </Grid>

                            <!-- 2. 动态专属属性配置面板 (通过反射与多类库数据模板选择器自动呈现) -->
                            <ContentControl Content="{Binding SelectedWidget}"
                                            ContentTemplateSelector="{x:Static propertyEditors:WidgetEditorTemplateSelector.Instance}" />

                            <!-- 3. 即时动态预览调试 (依组件/数据类型自适应呈现，静态标签与容器组件无需调试) -->
                             <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10"
                                     Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='!TextLabel,!PanelContainer,!Image'}">
                                 <StackPanel>
                                     <TextBlock Text="🔍 画面动态即时预览调试" FontWeight="SemiBold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,6"/>
                                     <DockPanel Margin="0,0,0,4">
                                         <TextBlock Text="当前呈现值:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                         <TextBlock Text="{Binding SelectedWidget.FormattedValue}" FontWeight="Bold" FontSize="12" Foreground="#0284C7" HorizontalAlignment="Right"/>
                                     </DockPanel>

                                     <!-- 3.1 模拟量滑块调试 (针对数值型与图表组件) -->
                                     <StackPanel Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='GaugeCircular,GaugeArc,LevelTank,NumericCard,TrendChart,DisplayBox'}">
                                         <Slider Minimum="{Binding SelectedWidget.MinValue}" Maximum="{Binding SelectedWidget.MaxValue}"
                                                 Value="{Binding SelectedWidget.CurrentRawValue, Mode=TwoWay}"
                                                 Margin="0,4,0,6" ValueChanged="OnPreviewSliderValueChanged"/>
                                         <DockPanel>
                                             <TextBlock Text="{Binding SelectedWidget.MinValue, StringFormat='下限: {0}'}" FontSize="9" Foreground="#94A3B8"/>
                                             <TextBlock Text="{Binding SelectedWidget.MaxValue, StringFormat='上限: {0}'}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                         </DockPanel>
                                     </StackPanel>

                                     <!-- 3.2 开关量快速置位按钮 (针对 StatusLed 状态指示灯、Valve 控制阀门、Pump 离心泵) -->
                                     <Grid Margin="0,2,0,0"
                                           Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='StatusLed,Valve,Pump'}">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="6"/>
                                             <ColumnDefinition Width="*"/>
                                         </Grid.ColumnDefinitions>
                                         <Button Grid.Column="0" Content="⚡ 快速置 1 (导通/运行)" Height="26" FontSize="11" Background="#DCFCE7" Foreground="#15803D" BorderBrush="#86EFAC" Click="OnSimulateValueOneClick"/>
                                         <Button Grid.Column="2" Content="⏹️ 快速置 0 (截止/停机)" Height="26" FontSize="11" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" Click="OnSimulateValueZeroClick"/>
                                     </Grid>

                                     <!-- 3.3 IO 矩阵快速测试信号 (针对 IoMatrix) -->
                                     <StackPanel Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='IoMatrix'}" Margin="0,2,0,0">
                                         <TextBlock Text="快速注入点阵模拟数据:" FontSize="10" Foreground="#64748B" Margin="0,0,0,4"/>
                                         <UniformGrid Columns="4">
                                             <Button Content="全通 0xFF" Tag="0xFF" Height="22" FontSize="9" Margin="1" Click="OnSimulateIoPatternClick"/>
                                             <Button Content="全断 0x00" Tag="0x00" Height="22" FontSize="9" Margin="1" Click="OnSimulateIoPatternClick"/>
                                             <Button Content="交替 0xAA" Tag="0xAA" Height="22" FontSize="9" Margin="1" Click="OnSimulateIoPatternClick"/>
                                             <Button Content="低4位 0x0F" Tag="0x0F" Height="22" FontSize="9" Margin="1" Click="OnSimulateIoPatternClick"/>
                                         </UniformGrid>
                                     </StackPanel>

                                     <!-- 3.4 控制按钮测试触发 (针对 ControlButton) -->
                                     <Button Content="🔘 模拟执行下发写入指令" Height="26" FontSize="11" Margin="0,4,0,0"
                                             Background="#E0F2FE" Foreground="#0369A1" BorderBrush="#BAE6FD"
                                             Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='ControlButton'}"
                                             Click="OnSimulateValueOneClick"/>

                                     <!-- 3.5 设备状态快速切换模拟 (针对 DeviceStatus) -->
                                     <StackPanel Visibility="{Binding SelectedWidget.Type, Converter={x:Static vm:DesignerUiConverters.WidgetTypeVisibility}, ConverterParameter='DeviceStatus'}" Margin="0,4,0,0">
                                         <TextBlock Text="快速模拟设备通信状态:" FontSize="10" Foreground="#64748B" Margin="0,0,0,4"/>
                                         <UniformGrid Columns="3">
                                             <Button Content="🟢 在线正常" Height="24" FontSize="10" Margin="1" Background="#DCFCE7" Foreground="#15803D" BorderBrush="#86EFAC" Click="OnSimulateDeviceOnlineClick"/>
                                             <Button Content="🟡 响应超时" Height="24" FontSize="10" Margin="1" Background="#FEF9C3" Foreground="#854D0E" BorderBrush="#FDE047" Click="OnSimulateDeviceTimeoutClick"/>
                                             <Button Content="🔴 通信中断" Height="24" FontSize="10" Margin="1" Background="#FEE2E2" Foreground="#991B1B" BorderBrush="#FCA5A5" Click="OnSimulateDeviceOfflineClick"/>
                                         </UniformGrid>
                                     </StackPanel>
                                 </StackPanel>
                             </Border>
                        </StackPanel>

                        <!-- 未选中组件时展示画面全局属性 -->
                        <StackPanel Visibility="{Binding SelectedWidget, Converter={x:Static vm:DesignerUiConverters.NullToVisible}}">
                            <TextBlock Text="📄 画面全局参数" FontSize="14" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,12"/>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="画布自增 ID / 标识代码 (ViewId):" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                    <TextBlock Text="⚡ 自增" FontSize="9" Foreground="#0369A1" FontWeight="SemiBold"/>
                                </Border>
                            </DockPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SelectedView.Id, StringFormat='#{0}'}" Height="28" IsReadOnly="True" Background="#F1F5F9" Foreground="#0369A1" FontWeight="Bold" HorizontalContentAlignment="Center"/>
                                <TextBox Grid.Column="2" Text="{Binding SelectedView.ViewId}" IsReadOnly="True" Background="#F1F5F9" Height="28" Foreground="#64748B" ToolTip="系统自动分配的画面唯一标识代码"/>
                            </Grid>

                            <TextBlock Text="画面名称 (Name):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedView.Name}" Height="28" Margin="0,0,0,10"/>

                            <TextBlock Text="画布参考宽度 (px):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedView.CanvasWidth}" Height="28" Margin="0,0,0,10"/>

                            <TextBlock Text="画布参考高度 (px):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedView.CanvasHeight}" Height="28" Margin="0,0,0,10"/>

                            <TextBlock Text="画布底色 (BackgroundColor):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <controls:ColorPickerBox ColorHex="{Binding SelectedView.BackgroundColor, Mode=TwoWay}" Margin="0,0,0,10"/>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="🖼️ 画布背景底图设置" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,8"/>

                                    <TextBlock Text="背景图片文件路径:" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding SelectedView.BackgroundImagePath, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="10"/>
                                        <Button Grid.Column="2" Content="浏览..." Height="26" FontSize="10" Background="#E0F2FE" Foreground="#0369A1" BorderBrush="#BAE6FD" Command="{Binding BrowseBackgroundImageCommand}"/>
                                        <Button Grid.Column="4" Content="清除" Height="26" FontSize="10" Background="#F1F5F9" Foreground="#64748B" BorderBrush="#CBD5E1" Command="{Binding ClearBackgroundImageCommand}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="图像拉伸方式 (Stretch):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <ComboBox Text="{Binding SelectedView.BackgroundImageStretch, UpdateSourceTrigger=PropertyChanged}" Height="26" IsEditable="True">
                                                <ComboBoxItem Content="UniformToFill"/>
                                                <ComboBoxItem Content="Uniform"/>
                                                <ComboBoxItem Content="Fill"/>
                                                <ComboBoxItem Content="None"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding SelectedView.BackgroundImageOpacity, StringFormat='底图透明度: {0:F2}'}" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <Slider Minimum="0.05" Maximum="1.0" Value="{Binding SelectedView.BackgroundImageOpacity}" TickFrequency="0.05" Height="26" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                <TextBlock Text="💡 提示: 从左侧工具箱拖拽或双击向画布添加组件；在画布上可自由拖动组件调整坐标；选中组件在右侧即时配置标题与点位！"
                                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. 底部状态栏 -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#475569"/>
                <TextBlock Text="WPF WYSIWYG SCADA Designer" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
