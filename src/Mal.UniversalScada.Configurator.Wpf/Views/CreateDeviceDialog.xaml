<Window x:Class="Mal.UniversalScada.Configurator.Wpf.Views.CreateDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建下位机设备"
        Height="470" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        Foreground="#0F172A">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.05" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="📟 新建下位机设备" FontSize="18" FontWeight="Bold" Foreground="#0284C7"/>
                    <TextBlock Text="请配置设备参数，所属通道与通信协议创建后将被锁定不可修改" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="设备唯一标识 ID (DeviceId):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtDeviceId" Height="32" Margin="0,0,0,10"/>

                        <TextBlock Text="设备友好名称 (Name):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtDeviceName" Height="32" Margin="0,0,0,10"/>

                        <TextBlock Text="所属通信通道 (Channel):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboChannels" SelectedValuePath="ChannelId" DisplayMemberPath="Name" Margin="0,0,0,10" SelectionChanged="CboChannels_SelectionChanged"/>

                        <TextBlock Text="通信协议类型 (ProtocolType):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboProtocolTypes" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="从站站号 (StationAddress):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtStationAddress" Text="1" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="轮询周期 (ms):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPollInterval" Text="100" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" MinHeight="16"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="取消" Width="80" Height="34" Margin="0,0,10,0" 
                            Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold"
                            IsCancel="True" Click="BtnCancel_Click"/>
                    <Button Content="确认创建" Width="90" Height="34" 
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                            IsDefault="True" Click="BtnSubmit_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
