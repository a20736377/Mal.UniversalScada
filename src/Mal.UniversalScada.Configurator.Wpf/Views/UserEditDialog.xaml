<Window x:Class="Mal.UniversalScada.Configurator.Wpf.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户信息配置"
        Height="540" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        Foreground="#0F172A">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.05" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部标题 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="TxtTitle" Text="👤 用户账户配置" FontSize="18" FontWeight="Bold" Foreground="#0284C7"/>
                    <TextBlock Text="配置操作员与工程师的登录账户、身份角色及状态" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 表单主体 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 用户自增 ID -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="用户自增编号 (ID):" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                <TextBlock Text="⚡ 自增主键 (只读)" FontSize="10" Foreground="#0369A1" FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>
                        <TextBox x:Name="TxtUserId" Height="32" Margin="0,0,0,10" IsReadOnly="True" Background="#F1F5F9" Foreground="#0369A1" FontWeight="Bold"/>

                        <!-- 用户名 -->
                        <TextBlock Text="登录账户名 (Username):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtUsername" Height="32" Margin="0,0,0,10"/>

                        <!-- 真实姓名/显示名 -->
                        <TextBlock Text="显示姓名 / 备注 (DisplayName):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtDisplayName" Height="32" Margin="0,0,0,10"/>

                        <!-- 权限角色 -->
                        <TextBlock Text="系统角色权限 (Role):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboRole" Margin="0,0,0,10"/>

                        <!-- 是否启用账户 -->
                        <CheckBox x:Name="ChkIsEnabled" Content="启用该账户 (勾选后允许登录监控大屏)" IsChecked="true"
                                  Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,14" VerticalContentAlignment="Center"/>

                        <!-- 分割线 -->
                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,14"/>

                        <!-- 密码设置区 -->
                        <TextBlock x:Name="LblPasswordTip" Text="设置登录密码 (必填，至少3位):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtPassword" Height="32" Margin="0,0,0,10"/>

                        <TextBlock Text="确认密码:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtConfirmPassword" Height="32" Margin="0,0,0,6"/>

                        <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部操作按钮 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="取消" Width="90" Height="32" Margin="0,0,10,0"
                            Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1"
                            Click="BtnCancel_Click"/>
                    <Button Content="保存并应用" Width="100" Height="32"
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
