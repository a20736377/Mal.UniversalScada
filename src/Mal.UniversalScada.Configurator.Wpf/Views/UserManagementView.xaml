<UserControl x:Class="Mal.UniversalScada.Configurator.Wpf.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mal.UniversalScada.Configurator.Wpf.ViewModels"
             xmlns:models="clr-namespace:Mal.UniversalScada.Core.Models;assembly=Mal.UniversalScada.Core"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vm:UserManagementViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <!-- 左侧：用户列表 -->
            <ColumnDefinition Width="480" MinWidth="380" MaxWidth="650"/>
            <ColumnDefinition Width="6"/>
            <!-- 右侧：画面方案多对多授权 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：用户列表卡片 -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="8" Padding="16">
            <DockPanel>
                <!-- 顶部操作栏 -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="👥 系统账户列表" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                        <TextBlock Text="管理可登录 SCADA 监控端的操作员与工程师" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="➕ 新建" Padding="10,5" Height="30" Margin="0,0,6,0"
                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                                Command="{Binding CreateUserCommand}"/>
                        <Button Content="✏️ 编辑" Padding="8,5" Height="30" Margin="0,0,6,0"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                Command="{Binding EditUserCommand}"/>
                        <Button Content="🗑️ 删除" Padding="8,5" Height="30" Margin="0,0,6,0"
                                Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                                Command="{Binding DeleteUserCommand}"/>
                        <Button Content="🔄" Padding="8,5" Height="30"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                ToolTip="从数据库刷新用户"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </DockPanel>

                <!-- 用户表格 -->
                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow" Background="#FFFFFF"
                          BorderBrush="#E2E8F0" BorderThickness="1" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="用户ID" Binding="{Binding Id}" Width="70" FontWeight="Bold"/>
                        <DataGridTextColumn Header="登录账号" Binding="{Binding Username}" Width="100"/>
                        <DataGridTextColumn Header="姓名/备注" Binding="{Binding DisplayName}" Width="110"/>
                        <DataGridTemplateColumn Header="角色" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="{x:Static models:UserRole.Administrator}">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="{x:Static models:UserRole.Engineer}">
                                                        <Setter Property="Background" Value="#EDE9FE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="{x:Static models:UserRole.Operator}">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                    <Setter Property="Text" Value="访客"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="{x:Static models:UserRole.Administrator}">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                            <Setter Property="Text" Value="管理员"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="{x:Static models:UserRole.Engineer}">
                                                            <Setter Property="Foreground" Value="#6D28D9"/>
                                                            <Setter Property="Text" Value="工程师"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="{x:Static models:UserRole.Operator}">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                            <Setter Property="Text" Value="操作员"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="状态" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="🟢 启用"/>
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Text" Value="🔴 禁用"/>
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="最后登录" Binding="{Binding LastLoginTime, StringFormat='{}{0:MM-dd HH:mm}'}" Width="95" Foreground="#64748B"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 分割条 -->
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E2E8F0" ResizeDirection="Columns"/>

        <!-- 右侧：画面方案多对多授权卡片 -->
        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="8" Padding="16">
            <DockPanel>
                <!-- 顶部标题与保存操作 -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="🖼️ 监控画面方案授权 (多对多矩阵)" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                        <TextBlock Text="配置选中用户在大屏监控端 (UI.Wpf) 允许查看和控制的画面预设" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="全选" Padding="10,5" Height="30" Margin="0,0,6,0"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                Command="{Binding SelectAllViewsCommand}"/>
                        <Button Content="清空" Padding="10,5" Height="30" Margin="0,0,12,0"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                Command="{Binding UnselectAllViewsCommand}"/>
                        <Button Content="💾 保存当前用户授权" Padding="14,5" Height="30"
                                Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                                Command="{Binding SavePermissionsCommand}"/>
                    </StackPanel>
                </DockPanel>

                <!-- 当前授权用户提示条 -->
                <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="当前授权对象: " FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedUser.Username, TargetNullValue='(未选择用户)'}" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="[" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedUser.DisplayName, TargetNullValue='-'}" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBlock Text="]" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <!-- 管理员特权提示 -->
                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="8,2"
                                    Visibility="{Binding IsAdminSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="👑 超级管理员默认拥有所有画面的完整访问权限，不受限制" FontSize="11" Foreground="#B45309" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 画面方案多选列表 -->
                <DataGrid ItemsSource="{Binding AvailableViews}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <!-- 允许访问 CheckBox (多对多授权核心) -->
                        <DataGridCheckBoxColumn Header="允许访问" Binding="{Binding IsAllowed, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                        <DataGridTextColumn Header="画面名称" Binding="{Binding Name}" Width="200" FontWeight="Bold" IsReadOnly="True"/>
                        <DataGridTextColumn Header="画面标识 (ViewId)" Binding="{Binding ViewId}" Width="160" Foreground="#64748B" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="默认画面" Width="80" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"
                                            Background="#DBEAFE">
                                        <TextBlock Text="⭐ 默认" FontSize="10" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="组件数" Binding="{Binding WidgetCount}" Width="70" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="画布规格" Width="100" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CanvasWidth, StringFormat='{}{0} × '}" VerticalAlignment="Center" Foreground="#64748B">
                                        <Run Text="{Binding CanvasHeight, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
