<Window x:Class="Mal.UniversalScada.Configurator.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Mal.UniversalScada.Configurator.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="SCADA 组态后台 - 管理员登录"
        Height="470" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        Foreground="#0F172A">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <!-- 亮色中心卡片容器 -->
        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="28,24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.06" Color="#000000"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 头部标题 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18" HorizontalAlignment="Center">
                    <TextBlock Text="🛠️ SCADA 组态设置后台" FontSize="20" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                    <TextBlock Text="通道 · 设备 · 点位工程组态系统" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 登录表单 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <!-- 用户名 -->
                    <TextBlock Text="管理员账号:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtUsername"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                             Height="38" FontSize="14"
                             KeyDown="TxtUsername_KeyDown"/>

                    <!-- 密码 -->
                    <TextBlock Text="管理员密码:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,14,0,6"/>
                    <PasswordBox x:Name="TxtPassword" 
                                 Height="38" FontSize="14"
                                 PasswordChanged="TxtPassword_PasswordChanged"/>

                    <!-- 错误提示 -->
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="#DC2626" FontSize="12" Margin="0,8,0,0"
                               TextWrapping="Wrap" MinHeight="18" HorizontalAlignment="Center"/>

                    <!-- 初始凭据引导提示框 (亮绿色卡片) -->
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                        <TextBlock Text="💡 提示：系统内置超级管理员账号: admin，初始密码: admin888" 
                                   FontSize="11" Foreground="#15803D" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- 底部按钮操作栏 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="退出" Width="85" Height="36" Margin="0,0,12,0"
                            Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold"
                            IsCancel="True" Click="BtnCancel_Click"/>
                    <Button Content="登录系统" Width="105" Height="36"
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                            IsDefault="True" Command="{Binding LoginCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
