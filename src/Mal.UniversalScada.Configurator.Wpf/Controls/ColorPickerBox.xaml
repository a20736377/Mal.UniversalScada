<UserControl x:Class="Mal.UniversalScada.Configurator.Wpf.Controls.ColorPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="240">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 颜色色块按钮 (点击即弹出调色层) -->
        <Border Grid.Column="0" Height="26" Width="28" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1.5"
                Cursor="Hand" MouseDown="OnTogglePopupClick" ToolTip="点击打开颜色调色板">
            <Border x:Name="ColorPreviewBorder" CornerRadius="3" Background="#0284C7"/>
        </Border>

        <!-- Hex 颜色代码输入框 (支持直接输入或粘贴) -->
        <TextBox x:Name="HexTextBox" Grid.Column="1" Height="26" Margin="6,0"
                 VerticalContentAlignment="Center" FontFamily="Consolas, Segoe UI" FontSize="11"
                 TextChanged="OnHexTextBoxChanged"/>

        <!-- 调色弹窗触发按钮 -->
        <Button Grid.Column="2" Content="🎨 调色" Height="26" Padding="6,0" FontSize="11"
                Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" Click="OnTogglePopupClick"/>

        <!-- 调色浮层 (Popup) -->
        <Popup x:Name="PickerPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=ColorPreviewBorder}"
               Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8"
                    Padding="12" Width="260" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 当前颜色大预览与说明 -->
                    <DockPanel Margin="0,0,0,10">
                        <Border x:Name="PopupCurrentPreview" Width="36" Height="36" CornerRadius="6"
                                BorderBrush="#94A3B8" BorderThickness="1" Margin="0,0,8,0" Background="#0284C7"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="当前选定色彩" FontSize="10" Foreground="#64748B"/>
                            <TextBlock x:Name="PopupHexLabel" Text="#0284C7" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 1. 工业经典色板 (24 个快选色) -->
                    <TextBlock Text="工业经典主题色:" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <UniformGrid Columns="8" Margin="0,0,0,10">
                        <Button Background="#0284C7" Tag="#0284C7" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="科技蓝 #0284C7"/>
                        <Button Background="#38BDF8" Tag="#38BDF8" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="天际蓝 #38BDF8"/>
                        <Button Background="#06B6D4" Tag="#06B6D4" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="极光青 #06B6D4"/>
                        <Button Background="#2563EB" Tag="#2563EB" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="深海蓝 #2563EB"/>

                        <Button Background="#10B981" Tag="#10B981" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="运行绿 #10B981"/>
                        <Button Background="#22C55E" Tag="#22C55E" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="鲜绿 #22C55E"/>
                        <Button Background="#16A34A" Tag="#16A34A" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="深绿 #16A34A"/>
                        <Button Background="#84CC16" Tag="#84CC16" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="青柠绿 #84CC16"/>

                        <Button Background="#EF4444" Tag="#EF4444" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="危险红 #EF4444"/>
                        <Button Background="#DC2626" Tag="#DC2626" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="深红 #DC2626"/>
                        <Button Background="#F43F5E" Tag="#F43F5E" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="玫瑰红 #F43F5E"/>
                        <Button Background="#E11D48" Tag="#E11D48" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="绯红 #E11D48"/>

                        <Button Background="#F59E0B" Tag="#F59E0B" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="预警黄 #F59E0B"/>
                        <Button Background="#F97316" Tag="#F97316" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="警戒橙 #F97316"/>
                        <Button Background="#EAB308" Tag="#EAB308" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="琥珀黄 #EAB308"/>
                        <Button Background="#8B5CF6" Tag="#8B5CF6" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="状态紫 #8B5CF6"/>

                        <Button Background="#334155" Tag="#334155" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="暗炭灰 #334155"/>
                        <Button Background="#1E293B" Tag="#1E293B" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="深空黑 #1E293B"/>
                        <Button Background="#475569" Tag="#475569" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="冷灰 #475569"/>
                        <Button Background="#64748B" Tag="#64748B" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="中灰 #64748B"/>

                        <Button Background="#94A3B8" Tag="#94A3B8" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="浅灰 #94A3B8"/>
                        <Button Background="#CBD5E1" Tag="#CBD5E1" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="银灰 #CBD5E1"/>
                        <Button Background="#F8FAFC" Tag="#F8FAFC" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="雪白 #F8FAFC"/>
                        <Button Background="#FFFFFF" Tag="#FFFFFF" Height="20" Margin="1" Click="OnPresetColorClick" ToolTip="纯白 #FFFFFF"/>
                    </UniformGrid>

                    <!-- 2. RGB 精准调色滑块 -->
                    <TextBlock Text="RGB 调色滑块 (实时生效):" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="R" Width="14" FontSize="10" Foreground="#EF4444" FontWeight="Bold"/>
                        <TextBlock x:Name="RValueLabel" Text="2" Width="26" FontSize="10" TextAlignment="Right"/>
                        <Slider x:Name="RSlider" Minimum="0" Maximum="255" Margin="6,0,0,0" ValueChanged="OnRgbSliderChanged"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="G" Width="14" FontSize="10" Foreground="#10B981" FontWeight="Bold"/>
                        <TextBlock x:Name="GValueLabel" Text="132" Width="26" FontSize="10" TextAlignment="Right"/>
                        <Slider x:Name="GSlider" Minimum="0" Maximum="255" Margin="6,0,0,0" ValueChanged="OnRgbSliderChanged"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="B" Width="14" FontSize="10" Foreground="#3B82F6" FontWeight="Bold"/>
                        <TextBlock x:Name="BValueLabel" Text="199" Width="26" FontSize="10" TextAlignment="Right"/>
                        <Slider x:Name="BSlider" Minimum="0" Maximum="255" Margin="6,0,0,0" ValueChanged="OnRgbSliderChanged"/>
                    </DockPanel>

                    <!-- 3. 打开 Windows 系统原生调色盘 -->
                    <Button Content="🖥️ 更多系统自定义颜色..." Margin="0,10,0,0" Height="26" FontSize="11"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" Click="OnOpenSystemColorDialogClick"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
