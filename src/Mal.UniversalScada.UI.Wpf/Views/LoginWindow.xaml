<Window x:Class="Mal.UniversalScada.UI.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户身份权限验证" Height="420" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="#0F172A" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#0284C7" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 标题栏 -->
                <RowDefinition Height="Auto"/> <!-- 权限拦截提示 -->
                <RowDefinition Height="*"/>    <!-- 输入区 -->
                <RowDefinition Height="Auto"/> <!-- 错误信息 -->
                <RowDefinition Height="Auto"/> <!-- 底部按钮 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶部标题与关闭 -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="工控权限验证与用户切换" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Role-Based Access Control (RBAC)" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14"
                        Cursor="Hand" Click="OnCancelClick"/>
            </Grid>

            <!-- 2. 权限拦截提示信息 -->
            <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                <TextBlock x:Name="PromptTextBlock" Text="下发控制指令或更改配方参数需要操作员或工程师权限。" 
                           Foreground="#38BDF8" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- 3. 表单输入区 -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <TextBlock Text="用户名 / 账号:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" Height="36" Background="#1E293B" Foreground="#FFFFFF"
                         BorderBrush="#334155" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"
                         FontSize="13" Margin="0,0,0,12" KeyDown="OnInputKeyDown"/>

                <TextBlock Text="密码:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Height="36" Background="#1E293B" Foreground="#FFFFFF"
                             BorderBrush="#334155" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"
                             FontSize="13" Margin="0,0,0,10" KeyDown="OnInputKeyDown"/>

                <!-- 预置账户快捷提示 -->
                <TextBlock Text="预置账户: operator (密码 op123) / engineer (密码 eng123) / admin (admin888)"
                           Foreground="#64748B" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 4. 错误信息栏 -->
            <TextBlock x:Name="ErrorTextBlock" Grid.Row="3" Foreground="#F87171" FontSize="12" FontWeight="SemiBold"
                       Margin="0,6,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>

            <!-- 5. 底部按钮 -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="取消 / 保持访客" Height="36"
                        Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1"
                        Cursor="Hand" Click="OnCancelClick"/>

                <Button Grid.Column="2" Content="登录验证" Height="36"
                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="OnLoginClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
