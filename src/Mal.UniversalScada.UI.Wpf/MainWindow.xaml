<Window x:Class="Mal.UniversalScada.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Wpf.ViewModels"
        xmlns:widgets="clr-namespace:Mal.UniversalScada.UI.Controls.Widgets;assembly=Mal.UniversalScada.UI.Controls"
        mc:Ignorable="d"
        Title="SCADA 实时工业测控系统 (Mal.UniversalScada.UI)"
        Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#070B14"
        Foreground="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/> <!-- 0: 顶部高科技导航与操作条 -->
            <RowDefinition Height="Auto"/> <!-- 1: 实时报警横幅流水条 -->
            <RowDefinition Height="*"/>  <!-- 2: 中间实时动态工业画布 -->
            <RowDefinition Height="32"/> <!-- 3: 底部状态与通信性能条 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部操作栏 -->
        <Border Grid.Row="0" Background="#0B1120" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <!-- 左侧：系统 Logo 与标题 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Background="#0284C7" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="🏭" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SCADA 实时工业测控系统" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                            <Border Background="#064E3B" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Universal Industrial SCADA Platform v2.0" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- 中间：画面切换、多屏投射、工艺配方 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 画面选择器 -->
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖥️ 画面:" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Views}" SelectedItem="{Binding CurrentView}" DisplayMemberPath="Name"
                                      Width="230" Height="30" FontSize="12" FontWeight="Bold"
                                      Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1"
                                      VerticalContentAlignment="Center" Cursor="Hand"/>
                            <Button Content="🔄 刷新" Margin="8,0,0,0" Height="30" Padding="10,2" FontSize="11" FontWeight="Bold"
                                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" Cursor="Hand"
                                    Command="{Binding ReloadViewsCommand}" ToolTip="热重载最新的画面方案列表 (同步设计器配置)">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 多屏投射大屏管理 -->
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📽️ 投屏:" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}" DisplayMemberPath="DisplayText"
                                      Width="210" Height="30" FontSize="11" FontWeight="SemiBold"
                                      Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                      VerticalContentAlignment="Center" Cursor="Hand"/>
                            <Button Content="全屏投射" Margin="8,0,0,0" Height="30" Padding="10,2" FontSize="11" FontWeight="Bold"
                                    Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding ProjectCurrentViewCommand}" ToolTip="在所选物理显示器上开启 Kiosk 全屏无边框看板">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="关闭" Margin="6,0,0,0" Height="30" Padding="8,2" FontSize="11" FontWeight="SemiBold"
                                    Background="#334155" Foreground="#E2E8F0" BorderBrush="#475569" BorderThickness="1" Cursor="Hand"
                                    Command="{Binding CloseAllProjectionsCommand}" ToolTip="关闭所有副屏投射视窗">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右侧：引擎控制、缩放与时钟 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 缩放控制 -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="➖" Width="26" Height="26" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                    Command="{Binding ZoomOutCommand}" ToolTip="缩小画布"/>
                            <TextBlock Text="{Binding ZoomScale, StringFormat={}{0:P0}}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"
                                       VerticalAlignment="Center" Margin="4,0"/>
                            <Button Content="➕" Width="26" Height="26" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                    Command="{Binding ZoomInCommand}" ToolTip="放大画布"/>
                            <Button Content="1:1" Width="28" Height="26" Background="Transparent" Foreground="#64748B" BorderThickness="0"
                                    Command="{Binding ResetZoomCommand}" ToolTip="重置缩放"/>
                        </StackPanel>
                    </Border>

                    <!-- 采集引擎启停按钮 -->
                    <Button Content="{Binding IsEngineRunning, Converter={x:Static vm:RuntimeUiConverters.EngineStateText}}"
                            Padding="10,4" Height="28" Margin="0,0,10,0" FontWeight="Bold" FontSize="11"
                            Background="#064E3B" Foreground="#34D399" BorderBrush="#059669" BorderThickness="1"
                            Command="{Binding ToggleEngineCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- 用户身份与权限指示微标 -->
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                     Fill="{Binding CurrentUserRoleBadgeColor}"/>
                            <TextBlock Text="{Binding CurrentUsername}" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC" Margin="0,0,4,0"/>
                            <Border Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="2,0,6,0">
                                <TextBlock Text="{Binding CurrentUserRoleName}" FontSize="10" Foreground="#94A3B8"/>
                            </Border>
                            <Button Content="切换用户" Height="22" Padding="6,1" FontSize="10" FontWeight="SemiBold"
                                    Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding SwitchUserCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="3"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="注销" Height="22" Padding="6,1" Margin="4,0,0,0" FontSize="10" FontWeight="SemiBold"
                                    Background="#DC2626" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding LogoutCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="3"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 实时时钟 -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTime}" Foreground="#94A3B8" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold"/>
                        <TextBlock Text="UTC+8" Foreground="#475569" FontSize="9" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 挂载实时报警横幅流水条 (AlarmBannerControl) -->
        <widgets:AlarmBannerControl Grid.Row="1" DataContext="{Binding AlarmBanner}"/>

        <!-- 3. 中间：实时动态工业画布 -->
        <Border Grid.Row="2" Background="#070B14">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid Width="{Binding CurrentView.CanvasWidth, FallbackValue=1600}"
                      Height="{Binding CurrentView.CanvasHeight, FallbackValue=900}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="20">
                    <!-- 暗黑科技网格背景 -->
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,40,40"/>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#131F37" Thickness="1"/>
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>

                    <!-- 缩放变换 -->
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                    </Grid.LayoutTransform>

                    <!-- 画面水印 -->
                    <TextBlock Text="{Binding CurrentView.Name}" Foreground="#1E293B" FontSize="16" FontWeight="Bold"
                               Margin="20,16,0,0" IsHitTestVisible="False"/>

                    <!-- 组件容器 (Canvas 绝对定位呈现) -->
                    <ItemsControl ItemsSource="{Binding Widgets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <widgets:WidgetHost />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                </ScrollViewer>

                <!-- 当用户未被分配任何画面权限时的空状态提示 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#1E293B" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="12"
                        Padding="36,28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoViewPermissions}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="暂无监控画面方案访问权限" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="当前登录账户尚未被管理员分配任何可用画面。" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="🔄 刷新权限" Padding="12,6" Height="32" Margin="0,0,10,0"
                                    Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                                    Command="{Binding ReloadViewsCommand}"/>
                            <Button Content="👤 切换用户" Padding="12,6" Height="32"
                                    Background="#334155" Foreground="#F8FAFC" FontWeight="Bold" BorderThickness="0"
                                    Command="{Binding SwitchUserCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 4. 底部状态栏 -->
        <Border Grid.Row="3" Background="#0B1120" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="|" Foreground="#334155" Margin="8,0"/>
                    <TextBlock Text="画面: " Foreground="#64748B" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentView.Name}" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="|" Foreground="#334155" Margin="8,0"/>
                    <TextBlock Text="活动图元: " Foreground="#64748B" FontSize="11"/>
                    <TextBlock Text="{Binding Widgets.Count}" Foreground="#34D399" FontSize="11" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="总线报文: " Foreground="#64748B" FontSize="11"/>
                    <TextBlock Text="{Binding PacketCounter}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Margin="0,0,16,0"/>
                    <TextBlock Text="Mal.UniversalScada Kiosk Edition v2.0" Foreground="#475569" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
