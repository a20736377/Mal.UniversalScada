<Window x:Class="Mal.UniversalScada.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Wpf.ViewModels"
        xmlns:widgets="clr-namespace:Mal.UniversalScada.UI.Controls.Widgets;assembly=Mal.UniversalScada.UI.Controls"
        mc:Ignorable="d"
        Title="SCADA 实时工业测控系统 (Mal.UniversalScada.UI)"
        Height="860" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="#070B14"
        Foreground="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/> <!-- 顶部高科技导航与画面选择条 -->
            <RowDefinition Height="*"/>  <!-- 中间实时动态工业画布 -->
            <RowDefinition Height="32"/> <!-- 底部状态与通信性能条 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部操作栏 -->
        <Border Grid.Row="0" Background="#0B1120" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <!-- 左侧：系统 Logo 与标题 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0284C7" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="🏭" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SCADA 实时工业测控系统" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                            <Border Background="#064E3B" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Universal Industrial SCADA Platform" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- 中间：【UI 画面选择器】 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖥️ 监控画面:" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding Views}" SelectedItem="{Binding CurrentView}" DisplayMemberPath="Name"
                                      Width="260" Height="34" FontSize="13" FontWeight="Bold"
                                      Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1.5"
                                      VerticalContentAlignment="Center" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右侧：引擎控制、缩放与时钟 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 缩放控制 -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="➖" Width="28" Height="28" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                    Command="{Binding ZoomOutCommand}" ToolTip="缩小画布"/>
                            <TextBlock Text="{Binding ZoomScale, StringFormat={}{0:P0}}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"
                                       VerticalAlignment="Center" Margin="4,0"/>
                            <Button Content="➕" Width="28" Height="28" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                    Command="{Binding ZoomInCommand}" ToolTip="放大画布"/>
                            <Button Content="1:1" Width="32" Height="28" Background="Transparent" Foreground="#64748B" BorderThickness="0"
                                    Command="{Binding ResetZoomCommand}" ToolTip="重置缩放"/>
                        </StackPanel>
                    </Border>

                    <!-- 采集引擎启停按钮 -->
                    <Button Content="{Binding IsEngineRunning, Converter={x:Static vm:RuntimeUiConverters.EngineStateText}}"
                            Padding="12,5" Height="32" Margin="0,0,14,0" FontWeight="Bold" FontSize="11"
                            Background="#064E3B" Foreground="#34D399" BorderBrush="#059669" BorderThickness="1"
                            Command="{Binding ToggleEngineCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- 实时时钟 -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTime}" Foreground="#94A3B8" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold"/>
                        <TextBlock Text="UTC+8 Beijing" Foreground="#475569" FontSize="9" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 中间：实时动态工业画布 -->
        <Border Grid.Row="1" Background="#070B14">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid Width="{Binding CurrentView.CanvasWidth, FallbackValue=1600}"
                      Height="{Binding CurrentView.CanvasHeight, FallbackValue=900}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="30">
                    <!-- 暗黑科技网格背景 -->
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,40,40"/>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#131F37" Thickness="1"/>
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>

                    <!-- 缩放变换 -->
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                    </Grid.LayoutTransform>

                    <!-- 画面水印 -->
                    <TextBlock Text="{Binding CurrentView.Name}" Foreground="#1E293B" FontSize="16" FontWeight="Bold"
                               Margin="20,16,0,0" IsHitTestVisible="False"/>

                    <!-- 组件容器 (Canvas 绝对定位呈现) -->
                    <ItemsControl ItemsSource="{Binding Widgets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <widgets:WidgetHost />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 3. 底部状态栏 -->
        <Border Grid.Row="2" Background="#0B1120" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="|" Foreground="#334155" Margin="10,0"/>
                    <TextBlock Text="已连接画面: " Foreground="#64748B" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentView.Name}" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="|" Foreground="#334155" Margin="10,0"/>
                    <TextBlock Text="活动组件: " Foreground="#64748B" FontSize="11"/>
                    <TextBlock Text="{Binding Widgets.Count}" Foreground="#34D399" FontSize="11" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="数据包总数: " Foreground="#64748B" FontSize="11"/>
                    <TextBlock Text="{Binding PacketCounter}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Margin="0,0,16,0"/>
                    <TextBlock Text="Mal.UniversalScada Runtime v2.0" Foreground="#475569" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
