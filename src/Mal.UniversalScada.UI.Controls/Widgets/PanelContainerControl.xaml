<UserControl x:Class="Mal.UniversalScada.UI.Controls.Widgets.PanelContainerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Controls.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:WidgetViewModel}">
    <Border Background="{Binding PanelProps.FillColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
            BorderBrush="{Binding PanelProps.BorderColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
            BorderThickness="{Binding PanelProps.BorderThickness}"
            CornerRadius="{Binding PanelProps.CornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部工位容器标题栏 -->
            <Border Grid.Row="0"
                    Background="{Binding PanelProps.HeaderBgColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
                    BorderBrush="{Binding PanelProps.BorderColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="7,7,0,0"
                    Padding="10,6">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📦 " FontSize="12"/>
                        <TextBlock Text="{Binding PanelProps.GroupTitle}" Foreground="#E2E8F0" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#0369A1" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                        <TextBlock Text="STATION" FontSize="8" FontWeight="Bold" Foreground="#BAE6FD"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 内部容器提示背景 (设计模式下提示虚线) -->
            <Border Grid.Row="1" Margin="8" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Background="Transparent"
                    Opacity="0.4">
                <TextBlock Text="[ 区域容器：支持将组件拖动重叠至此区域内作为工位分区 ]"
                           Foreground="#475569" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsDesignMode, Converter={x:Static vm:WidgetUiConverters.BoolToVisibility}}"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
