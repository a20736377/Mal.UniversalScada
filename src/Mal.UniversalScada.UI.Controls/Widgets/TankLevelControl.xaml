<UserControl x:Class="Mal.UniversalScada.UI.Controls.Widgets.TankLevelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Controls.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:WidgetViewModel}">
    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="10" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>

            <!-- 储罐立体外壳 -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" Width="80" Margin="0,4">
                <!-- 刻度线 (左侧) -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="-20,0,0,0" Width="18">
                    <TextBlock Text="100%" FontSize="8" Foreground="#64748B"/>
                    <Border Height="1" Background="#334155" Margin="0,2"/>
                    <TextBlock Text="50%" FontSize="8" Foreground="#64748B" Margin="0,36,0,0"/>
                    <Border Height="1" Background="#334155" Margin="0,2"/>
                    <TextBlock Text="0%" FontSize="8" Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,36,0,0"/>
                </StackPanel>

                <!-- 储罐外壳 -->
                <Border Background="#090D16" BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="16"
                        ClipToBounds="True" Width="70" HorizontalAlignment="Center">
                    <Grid VerticalAlignment="Bottom">
                        <!-- 动态液位矩形 -->
                        <Border Background="#0284C7" Opacity="0.85" CornerRadius="0,0,14,14"
                                VerticalAlignment="Bottom">
                            <Border.Height>
                                <MultiBinding Converter="{x:Static vm:TankHeightConverter.Instance}">
                                    <Binding Path="NormalizedProgress"/>
                                    <Binding RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=2}" Path="ActualHeight"/>
                                </MultiBinding>
                            </Border.Height>
                            <!-- 液体顶部波浪高光 -->
                            <Border Height="4" VerticalAlignment="Top" Background="#38BDF8" Opacity="0.9"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 储罐高光反射 -->
                <Border Width="10" HorizontalAlignment="Left" Margin="10,6,0,6" Background="#FFFFFF" Opacity="0.08"
                        CornerRadius="4"/>
            </Grid>

            <!-- 底部数值与单位 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="{Binding FormattedValue}" Foreground="#38BDF8" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="{Binding Unit}" Foreground="#94A3B8" FontSize="11" Margin="4,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
