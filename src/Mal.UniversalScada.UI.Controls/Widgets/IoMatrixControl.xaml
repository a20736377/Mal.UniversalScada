                <TextBlock Text="{Binding IoProps.DisplayFormat, StringFormat='{}{0}:'}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FormattedValue}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ChannelGroupSummary}" Foreground="#475569" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
