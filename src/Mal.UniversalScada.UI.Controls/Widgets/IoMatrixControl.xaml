                                        <MultiBinding Converter="{x:Static vm:IoBitStatusConverter.Instance}" ConverterParameter="0">
                                            <Binding Path="CurrentRawValue"/>
                                            <Binding Path="IoProps.ActiveColor"/>
                                            <Binding Path="IoProps.InactiveColor"/>
                                        </MultiBinding>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="0" Foreground="#64748B" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
