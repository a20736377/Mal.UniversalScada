<UserControl x:Class="Mal.UniversalScada.UI.Controls.Widgets.ArcGaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Controls.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:WidgetViewModel}">
    <Border Background="#0F172A" BorderBrush="{Binding IsAlarm, Converter={x:Static vm:WidgetUiConverters.AlarmToBorderBrush}}" BorderThickness="1.5" CornerRadius="10" Padding="8">
        <!-- 矢量自适应表盘容器 -->
        <Viewbox Stretch="Uniform">
            <Canvas Width="200" Height="140" ClipToBounds="True">
                <!-- 1. 180° 外轮廓半圆弧轨道 -->
                <Path Data="{Binding ArcGaugeProps.OuterArcPathData}"
                      Stroke="#1E293B" StrokeThickness="1.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                <!-- 2. 次刻度线 (细密小齿刻度) -->
                <Path Data="{Binding ArcGaugeProps.MinorTicksPathData}"
                      Stroke="#475569" StrokeThickness="0.9"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                <!-- 3. 主刻度线 (凸出分度齿线) -->
                <Path Data="{Binding ArcGaugeProps.MajorTicksPathData}"
                      Stroke="#CBD5E1" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                <!-- 4. 6 个内侧主刻度数值标签 -->
                <!-- 刻度 1 (-90°) -->
                <TextBlock Canvas.Left="{Binding ArcGaugeProps.ScaleX1}" Canvas.Top="{Binding ArcGaugeProps.ScaleY1}"
                           Text="{Binding ArcGaugeProps.ScaleText1}"
                           Foreground="#94A3B8" FontSize="8" FontWeight="Medium"
                           TextAlignment="Center" Width="36" Margin="-18,-5,0,0"/>

                <!-- 刻度 2 (-54°) -->
                <TextBlock Canvas.Left="{Binding ArcGaugeProps.ScaleX2}" Canvas.Top="{Binding ArcGaugeProps.ScaleY2}"
                           Text="{Binding ArcGaugeProps.ScaleText2}"
                           Foreground="#94A3B8" FontSize="8" FontWeight="Medium"
                           TextAlignment="Center" Width="36" Margin="-18,-5,0,0"/>

                <!-- 刻度 3 (-18°) -->
                <TextBlock Canvas.Left="{Binding ArcGaugeProps.ScaleX3}" Canvas.Top="{Binding ArcGaugeProps.ScaleY3}"
                           Text="{Binding ArcGaugeProps.ScaleText3}"
                           Foreground="#94A3B8" FontSize="8" FontWeight="Medium"
                           TextAlignment="Center" Width="36" Margin="-18,-5,0,0"/>

                <!-- 4. 刻度 4 (+18°) -->
                <TextBlock Canvas.Left="{Binding ArcGaugeProps.ScaleX4}" Canvas.Top="{Binding ArcGaugeProps.ScaleY4}"
                           Text="{Binding ArcGaugeProps.ScaleText4}"
                           Foreground="#94A3B8" FontSize="8" FontWeight="Medium"
                           TextAlignment="Center" Width="36" Margin="-18,-5,0,0"/>

                <!-- 刻度 5 (+54°) -->
                <TextBlock Canvas.Left="{Binding ArcGaugeProps.ScaleX5}" Canvas.Top="{Binding ArcGaugeProps.ScaleY5}"
                           Text="{Binding ArcGaugeProps.ScaleText5}"
                           Foreground="#94A3B8" FontSize="8" FontWeight="Medium"
                           TextAlignment="Center" Width="36" Margin="-18,-5,0,0"/>

                <!-- 刻度 6 (+90°) -->
                <TextBlock Canvas.Left="{Binding ArcGaugeProps.ScaleX6}" Canvas.Top="{Binding ArcGaugeProps.ScaleY6}"
                           Text="{Binding ArcGaugeProps.ScaleText6}"
                           Foreground="#94A3B8" FontSize="8" FontWeight="Medium"
                           TextAlignment="Center" Width="36" Margin="-18,-5,0,0"/>

                <!-- 5. 亮青蓝发光剑形指针 (以 100, 102 为旋转枢轴，Angle -90° ~ +90°) -->
                <Canvas Width="200" Height="140" IsHitTestVisible="False">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{Binding ArcGaugeProps.NeedleAngle}" CenterX="100" CenterY="102"/>
                    </Canvas.RenderTransform>

                    <!-- 指针主体 -->
                    <Path Data="M 98.4 102 L 100 24 L 101.6 102 Z"
                          Fill="{Binding ColorHex, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="8" Color="{Binding ColorHex, Converter={x:Static vm:WidgetUiConverters.ColorHexToColor}}" ShadowDepth="0" Opacity="0.9"/>
                        </Path.Effect>
                    </Path>
                </Canvas>

                <!-- 6. 枢轴底盖 (小半圆装饰) -->
                <Ellipse Canvas.Left="95" Canvas.Top="97" Width="10" Height="10"
                         Fill="#0F172A"
                         Stroke="{Binding ColorHex, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
                         StrokeThickness="1.5"/>

                <!-- 7. 底部双行读数信息区 (根据用户反馈：上面是数值，下面是TITLE) -->
                <StackPanel Canvas.Left="10" Canvas.Top="108" Width="180" HorizontalAlignment="Center">
                    <!-- 第一行 (上面)：数值 + 单位 (居中大字显示) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,1">
                        <TextBlock Text="{Binding FormattedValue}"
                                   Foreground="#F8FAFC" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Bottom"/>
                        <TextBlock Text="{Binding Unit}"
                                   Foreground="{Binding ColorHex, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
                                   FontSize="8.5" FontWeight="SemiBold" Margin="4,0,0,0.5"
                                   VerticalAlignment="Bottom"
                                   Visibility="{Binding Unit, Converter={x:Static vm:WidgetUiConverters.StringNotEmptyToVisibility}}"/>
                    </StackPanel>

                    <!-- 第二行 (下面)：Title / 点位描述 (居中小字显示) -->
                    <TextBlock Text="{Binding Title}"
                               Foreground="#94A3B8" FontSize="9" FontWeight="Normal"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                </StackPanel>
            </Canvas>
        </Viewbox>
    </Border>
</UserControl>
