<UserControl x:Class="Mal.UniversalScada.UI.Controls.Widgets.AlarmBannerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Controls.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AlarmBannerViewModel, IsDesignTimeCreatable=True}">
    <Border Background="#090D16" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
        <StackPanel>
            <!-- 1. 主报警横幅条 (高度 36px) -->
            <Border Height="36" Padding="12,0" Background="#0F172A">
                <DockPanel LastChildFill="True">
                    <!-- 右侧操作区：展开/折叠与一键确认 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleExpandCommand}"
                                Content="🔔 报警清单"
                                Height="24" Padding="8,2" FontSize="11" FontWeight="SemiBold"
                                Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155"
                                Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Command="{Binding AcknowledgeAllCommand}"
                                Content="✔️ 一键确认 (ACK)"
                                Height="24" Padding="10,2" FontSize="11" FontWeight="Bold"
                                Background="#15803D" Foreground="#F0FDF4" BorderBrush="#22C55E"
                                Cursor="Hand"/>
                    </StackPanel>

                    <!-- 左侧：呼吸指示灯与统计微标 -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <!-- 报警动态呼吸灯 -->
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                 Fill="{Binding StatusColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}, FallbackValue='#10B981'}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnacknowledgedAlarms}" Value="True">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#EF4444" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Text="⚠️ 实时报警" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,6,0"/>

                        <!-- 未确认数量徽章 -->
                        <Border Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="10" Padding="6,1" VerticalAlignment="Center"
                                Visibility="{Binding HasUnacknowledgedAlarms, Converter={x:Static vm:WidgetUiConverters.BoolToVisibility}}">
                            <TextBlock Text="{Binding UnacknowledgedCount, StringFormat='{}{0} 未确认'}"
                                       FontSize="10" FontWeight="Bold" Foreground="#FEE2E2"/>
                        </Border>
                    </StackPanel>

                    <!-- 中间：滚动展示最新报警 -->
                    <DockPanel VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="{Binding LatestAlarm.TriggerTime, StringFormat='{}[{0:HH:mm:ss}]'}"
                                   FontSize="11" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LatestAlarm.TagId, StringFormat='{}{0}: '}"
                                   FontWeight="Bold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LatestAlarm.Message, FallbackValue='当前系统无异常活动报警，运行工况良好。'}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- 2. 展开的活跃报警列表抽屉 (默认折叠) -->
            <Border Background="#0B1323" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,8" MaxHeight="220"
                    Visibility="{Binding IsExpanded, Converter={x:Static vm:WidgetUiConverters.BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ActiveAlarms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="8,6" Background="#111D33" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 等级 -->
                                        <Border Grid.Column="0" Background="#2A1B1F" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Severity}" FontSize="9" FontWeight="Bold" Foreground="#FCA5A5"/>
                                        </Border>
                                        <!-- 时间 -->
                                        <TextBlock Grid.Column="1" Text="{Binding TriggerTime, StringFormat='{}{0:MM-dd HH:mm:ss}'}"
                                                   FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <!-- 消息 -->
                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <!-- 触发值 -->
                                        <TextBlock Grid.Column="3" Text="{Binding TriggerValue, StringFormat='{}值: {0:F2}'}"
                                                   FontSize="10" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <!-- 确认状态 -->
                                        <Border Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IsAcknowledged, Converter={x:Static vm:WidgetUiConverters.BoolToVisibility}, ConverterParameter='已确认|未确认', FallbackValue='未确认'}"
                                                       FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
