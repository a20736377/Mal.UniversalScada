<UserControl x:Class="Mal.UniversalScada.UI.Controls.Widgets.ControlButtonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Controls.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:WidgetViewModel}">
    <Grid>
        <!-- 普通按钮主体 (自适应全填充，无深色卡片外框，背景色由 ColorHex 驱动) -->
        <Button Click="OnExecuteClick"
                Background="{Binding ColorHex, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
                Foreground="#FFFFFF"
                FontWeight="SemiBold"
                FontSize="12"
                BorderThickness="1"
                BorderBrush="#38BDF8"
                Cursor="Hand"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Button.Content>
                <TextBlock Text="{Binding ButtonText, TargetNullValue='按钮'}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button.Content>
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</UserControl>

