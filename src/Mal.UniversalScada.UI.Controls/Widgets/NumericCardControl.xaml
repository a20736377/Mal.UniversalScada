<UserControl x:Class="Mal.UniversalScada.UI.Controls.Widgets.NumericCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Controls.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:WidgetViewModel}">
    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="10" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题与在线质量标识 -->
            <DockPanel Grid.Row="0">
                <TextBlock Text="{Binding Title}" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                <Border Background="#064E3B" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Quality}" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                </Border>
            </DockPanel>

            <!-- 中间核心数显与单位 -->
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding FormattedValue}"
                               Foreground="{Binding ColorHex, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
                               FontSize="26" FontWeight="Bold"
                               FontFamily="Consolas, Segoe UI" VerticalAlignment="Bottom">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#0284C7" ShadowDepth="0" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding Unit}" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"
                               Margin="6,0,0,3" VerticalAlignment="Bottom"/>
                </StackPanel>
            </Grid>

            <!-- 底部告警指示 -->
            <DockPanel Grid.Row="2" Margin="0,4,0,0" LastChildFill="False">
                <Border Background="#EF4444" CornerRadius="2" Padding="4,1" HorizontalAlignment="Right"
                        Visibility="{Binding IsAlarm, Converter={x:Static vm:WidgetUiConverters.BoolToVisibility}}">
                    <TextBlock Text="ALARM" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Border>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
