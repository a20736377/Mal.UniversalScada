<UserControl x:Class="Mal.UniversalScada.UI.Controls.Widgets.CircularGaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Controls.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:WidgetViewModel}">
    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="10" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题与点位标识 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="{Binding Title}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxWidth="120" VerticalAlignment="Center"/>
                <Border Background="#EF4444" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right"
                        Visibility="{Binding IsAlarm, Converter={x:Static vm:WidgetUiConverters.BoolToVisibility}}">
                    <TextBlock Text="ALARM" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Border>
            </DockPanel>

            <!-- 表盘核心区域 -->
            <Grid Grid.Row="1" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 仪表外圈装饰环 -->
                <Ellipse Stroke="#1E293B" StrokeThickness="8" Width="116" Height="116"/>
                <Ellipse Stroke="{Binding ColorHex, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
                         StrokeThickness="2" Width="104" Height="104" Opacity="0.4"
                         StrokeDashArray="2,3"/>

                <!-- 1. 刻度轨道底环槽 (暗色背景槽) -->
                <Path Stroke="#1E293B" StrokeThickness="7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                      Data="M 24.64 95.36 A 48 48 0 1 1 95.36 95.36"/>

                <!-- 2. 分段式温湿度表盘圆弧 (类似于湿度计的低段/中段/高段三色标度) -->
                <!-- 低段圆弧 (如干燥/低限: LowColor) -->
                <Path Stroke="{Binding GaugeProps.LowColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
                      StrokeThickness="6" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                      Data="{Binding GaugeProps.LowArcData}" Opacity="0.9"/>

                <!-- 中段圆弧 (如舒适/正常: MidColor) -->
                <Path Stroke="{Binding GaugeProps.MidColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
                      StrokeThickness="6" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                      Data="{Binding GaugeProps.MidArcData}" Opacity="0.9"/>

                <!-- 高段圆弧 (如潮湿/超限: HighColor) -->
                <Path Stroke="{Binding GaugeProps.HighColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
                      StrokeThickness="6" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                      Data="{Binding GaugeProps.HighArcData}" Opacity="0.9"/>

                <!-- 中心指针 (依 GaugeAngle 旋转) -->
                <Grid Width="110" Height="110">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="{Binding GaugeAngle}" CenterX="55" CenterY="55"/>
                    </Grid.RenderTransform>
                    <!-- 指针主体 -->
                    <Path Data="M 54 55 L 55 12 L 56 55 Z"
                          Fill="{Binding ColorHex, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="6" Color="{Binding ColorHex, Converter={x:Static vm:WidgetUiConverters.ColorHexToColor}}" ShadowDepth="0" Opacity="0.85"/>
                        </Path.Effect>
                    </Path>
                </Grid>

                <!-- 表盘中心轴圆心与数值 -->
                <Ellipse Width="44" Height="44" Fill="#090D16"
                         Stroke="{Binding ColorHex, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}" StrokeThickness="1.5"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding FormattedValue}" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Unit}"
                               Foreground="{Binding ColorHex, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"
                               FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 底部范围提示与低中高色标 -->
            <Grid Grid.Row="2" Margin="4,2,4,0">
                <TextBlock Text="{Binding MinValue, StringFormat={}{0:0}}" Foreground="#64748B" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <!-- 低/中/高三色区间微标提示 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding GaugeProps.EnableThresholdColor, Converter={x:Static vm:WidgetUiConverters.BoolToVisibility}}">
                    <Ellipse Width="6" Height="6" Margin="2,0"
                             Fill="{Binding GaugeProps.LowColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"/>
                    <Ellipse Width="6" Height="6" Margin="2,0"
                             Fill="{Binding GaugeProps.MidColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"/>
                    <Ellipse Width="6" Height="6" Margin="2,0"
                             Fill="{Binding GaugeProps.HighColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}}"/>
                </StackPanel>

                <TextBlock Text="{Binding MaxValue, StringFormat={}{0:0}}" Foreground="#64748B" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
