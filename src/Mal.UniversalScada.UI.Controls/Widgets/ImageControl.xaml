<UserControl x:Class="Mal.UniversalScada.UI.Controls.Widgets.ImageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Controls.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WidgetViewModel}">
    <Grid ClipToBounds="True">
        <!-- 1. 图片展示外层边框与背景容器 -->
        <Border CornerRadius="{Binding ImageProps.CornerRadius, FallbackValue=4}"
                BorderBrush="{Binding ImageProps.BorderColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}, FallbackValue='#334155'}"
                BorderThickness="{Binding ImageProps.BorderThickness, FallbackValue=0}"
                Background="{Binding ImageProps.BackgroundColor, Converter={x:Static vm:WidgetUiConverters.ColorHexToBrush}, FallbackValue=Transparent}"
                ClipToBounds="True">
            <Grid>
                <!-- 2. 图片主体渲染 -->
                <Image x:Name="ImgDisplay"
                       Source="{Binding ImageProps.ImagePath, Converter={x:Static vm:WidgetUiConverters.StringToImageSource}}"
                       Stretch="{Binding ImageProps.Stretch, Converter={x:Static vm:WidgetUiConverters.StringToStretch}, FallbackValue=Uniform}"
                       Opacity="{Binding ImageProps.Opacity, FallbackValue=1.0}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- 3. 未配置图片或空路径时的优雅占位提示 (半透明工控科技框) -->
                <Border Background="#1E293B"
                        BorderBrush="#475569"
                        BorderThickness="1"
                        CornerRadius="{Binding ImageProps.CornerRadius, FallbackValue=4}"
                        Padding="12"
                        Visibility="{Binding ImageProps.ImagePath, Converter={x:Static vm:WidgetUiConverters.StringNotEmptyToVisibility}, ConverterParameter=Inverse}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🖼️" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="0.8"/>
                        <TextBlock Text="{Binding Title, FallbackValue='图片组件'}"
                                   FontWeight="Bold" FontSize="11" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding ImageProps.FallbackText, FallbackValue='请在右侧属性面板配置图片路径'}"
                                   FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
