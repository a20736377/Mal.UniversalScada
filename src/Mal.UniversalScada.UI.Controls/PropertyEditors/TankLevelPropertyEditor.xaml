<UserControl x:Class="Mal.UniversalScada.UI.Controls.PropertyEditors.TankLevelPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mal.UniversalScada.UI.Controls.Controls"
             xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Controls.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TankLevelWidgetViewModel}">
    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="🛢️ 立体储罐专属组合参数 (TankLevelProps)" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,8"/>

            <TextBlock Text="安装方向 (Orientation):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
            <ComboBox SelectedValue="{Binding Props.Orientation, Mode=TwoWay}"
                      SelectedValuePath="Tag" Height="26" Margin="0,0,0,8">
                <ComboBoxItem Content="立式 / 竖向 (Vertical)" Tag="Vertical"/>
                <ComboBoxItem Content="卧式 / 横向 (Horizontal)" Tag="Horizontal"/>
            </ComboBox>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="容量下限 (Min):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Props.MinValue, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="容量上限 (Max):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Props.MaxValue, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="液位单位 (Unit, 如 % / L / m³):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
            <TextBox Text="{Binding Props.Unit, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="干涸预警液位 (Low):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Props.LowAlarm, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="溢出报警液位 (High):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Props.HighAlarm, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                </StackPanel>
            </Grid>

            <!-- 纯色液体颜色设置（以高限/低限为变色阈值） -->
            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="🎨 液体纯色设置 (以高限和低限为变色阈值)" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,6"/>

                    <!-- 低液位颜色 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="低液位色 (≤ 低限预警):" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                        <controls:ColorPickerBox Grid.Column="1" ColorHex="{Binding Props.LowColor, Mode=TwoWay}"/>
                    </Grid>

                    <!-- 正常区间颜色 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="正常液位色 (低限~高限):" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                        <controls:ColorPickerBox Grid.Column="1" ColorHex="{Binding Props.MidColor, Mode=TwoWay}"/>
                    </Grid>

                    <!-- 高液位颜色 -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="高液位色 (≥ 高限报警):" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                        <controls:ColorPickerBox Grid.Column="1" ColorHex="{Binding Props.HighColor, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
