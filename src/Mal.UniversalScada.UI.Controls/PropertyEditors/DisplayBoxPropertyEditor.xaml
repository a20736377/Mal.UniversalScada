<UserControl x:Class="Mal.UniversalScada.UI.Controls.PropertyEditors.DisplayBoxPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mal.UniversalScada.UI.Controls.Controls"
             xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Controls.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DisplayBoxWidgetViewModel}">
    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="🔲 普通显示框专属参数 (DisplayBoxProps)" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="前缀名称 (Prefix):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Props.Prefix, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="工程单位 (Unit):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Props.Unit, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="小数位数 (Decimals):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Props.Decimals, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="文本对齐 (Alignment):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <ComboBox Text="{Binding Props.Alignment, UpdateSourceTrigger=PropertyChanged}" Height="26" IsEditable="True">
                        <ComboBoxItem Content="Right"/>
                        <ComboBoxItem Content="Center"/>
                        <ComboBoxItem Content="Left"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="文字颜色 (TextColor):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <controls:ColorPickerBox ColorHex="{Binding Props.TextColor, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="边框颜色 (BorderColor):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <controls:ColorPickerBox ColorHex="{Binding Props.BorderColor, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="背景底色 (BackgroundColor):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
            <controls:ColorPickerBox ColorHex="{Binding Props.BackgroundColor, Mode=TwoWay}"/>
        </StackPanel>
    </Border>
</UserControl>
