<UserControl x:Class="Mal.UniversalScada.UI.Controls.PropertyEditors.ImagePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mal.UniversalScada.UI.Controls.Controls"
             xmlns:vm="clr-namespace:Mal.UniversalScada.UI.Controls.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ImageWidgetViewModel}">
    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="🖼️ 图片图元专属组合参数 (ImageProps)" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,8"/>

            <!-- 1. 图片源文件路径及选择 -->
            <TextBlock Text="图片文件路径或网络 URL (ImagePath):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Props.ImagePath, UpdateSourceTrigger=PropertyChanged}" Height="26"
                         ToolTip="支持本地绝对路径、相对路径或 http/https 网络图片地址"/>
                <Button Grid.Column="2" Content="📂 浏览..." Height="26" Padding="8,2" FontSize="11"
                        Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" Click="OnBrowseImageClick"/>
            </Grid>

            <!-- 2. 显示拉伸模式与不透明度 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="拉伸适配模式 (Stretch):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <ComboBox SelectedValue="{Binding Props.Stretch, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Tag" Height="26">
                        <ComboBoxItem Content="等比自适应 (Uniform)" Tag="Uniform"/>
                        <ComboBoxItem Content="充满裁剪 (UniformToFill)" Tag="UniformToFill"/>
                        <ComboBoxItem Content="拉伸充满 (Fill)" Tag="Fill"/>
                        <ComboBoxItem Content="原始尺寸 (None)" Tag="None"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <DockPanel Margin="0,0,0,3">
                        <TextBlock Text="不透明度 (Opacity):" FontSize="10" Foreground="#64748B"/>
                        <TextBlock Text="{Binding Props.Opacity, StringFormat='{}{0:P0}'}" FontSize="10" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider Minimum="0.1" Maximum="1.0" Value="{Binding Props.Opacity, Mode=TwoWay}"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 3. 圆角与边框粗细 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="边角圆角 (CornerRadius):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Props.CornerRadius, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="边框粗细 (BorderThickness):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Props.BorderThickness, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                </StackPanel>
            </Grid>

            <!-- 4. 边框颜色与底色 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="边框高亮颜色:" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <controls:ColorPickerBox ColorHex="{Binding Props.BorderColor, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="背景底色 (BackgroundColor):" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <controls:ColorPickerBox ColorHex="{Binding Props.BackgroundColor, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>

            <!-- 5. 动态相机快照定时自动刷新 -->
            <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,2,0,0">
                <StackPanel>
                    <CheckBox Content="🔄 开启定时自动刷新 (适合工控相机快照/巡检图)"
                              IsChecked="{Binding Props.IsAutoRefresh, Mode=TwoWay}"
                              FontWeight="SemiBold" FontSize="10" Foreground="#1E293B" Margin="0,0,0,4"/>
                    <DockPanel Visibility="{Binding Props.IsAutoRefresh, Converter={x:Static vm:WidgetUiConverters.BoolToVisibility}}">
                        <TextBlock Text="刷新周期 (秒):" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Props.RefreshIntervalSec, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" Height="24" HorizontalAlignment="Right" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
